# Environment Configuration Template for PayScale HTTPE
# Copy to .env for local runtime configuration

APP_NAME="PayScale High-Throughput Transaction Processing Engine"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL / SQLite for local tests)
# For local dev / testing: sqlite+aiosqlite:///./payscale_test.db
# For PostgreSQL: postgresql+asyncpg://payscale_admin:payscale_secure_password_2026@localhost:5432/payscale_shard_0
DATABASE_URL="sqlite+aiosqlite:///./payscale_test.db"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"

# Security & Secrets
JWT_SECRET_KEY="payscale-super-secret-key-for-dev-use-only-change-in-prod"
JWT_ALGORITHM="HS256"
WEBHOOK_SECRET="payscale-webhook-shared-secret-key"

# Performance & Rate Limits
MAX_BURST_TPS=18000
SUSTAINED_TPS=12000
FRAUD_TIMEOUT_MS=15
IDEMPOTENCY_TTL_SECONDS=86400
