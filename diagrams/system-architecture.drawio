        </mxCell>

        <!-- Database & Observability -->
        <mxCell id="c11-db" value="11. Database Layer (PostgreSQL 15 Sharded Cluster with PgBouncer)&#xa;Shard 0 (Settlement Pool) | Shard 1 (Accounts A-G) | Shard 2 (Accounts H-N) | Shard 3 (Accounts O-Z)&#xa;Synchronous Standbys (Patroni RTO &lt; 30s) + Read Replicas | Declarative Monthly Partitioning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E44AD;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1">
