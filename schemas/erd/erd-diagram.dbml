// PayScale HTTPE Database Schema in DBML (dbdiagram.io)
// High-Throughput Transaction Processing Engine Schema

Table users {
  user_id uuid [pk]
  phone_number varchar(20) [unique, not null]
  email varchar(255) [unique, not null]
  full_name varchar(255) [not null]
  kyc_status varchar(32) [not null, default: 'PENDING']
  kyc_tier varchar(32) [not null, default: 'MINIMUM']
  risk_score int [not null, default: 0]
  pan_hash char(64) [null]
  aadhaar_vault_ref varchar(128) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table accounts {
  account_id uuid [pk]
  user_id uuid [not null, ref: > users.user_id]
  account_type varchar(32) [not null]
  currency char(3) [not null, default: 'INR']
  available_balance numeric(18,4) [not null, default: 0.0000]
  ledger_balance numeric(18,4) [not null, default: 0.0000]
  version bigint [not null, default: 1]
  status varchar(32) [not null, default: 'ACTIVE']
  tier varchar(32) [not null, default: 'BASIC']
  shard_key int [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table transactions {
  transaction_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  idempotency_key varchar(128) [not null]
  transaction_type varchar(32) [not null]
  source_account_id uuid [null, ref: > accounts.account_id]
  destination_account_id uuid [null, ref: > accounts.account_id]
  amount numeric(18,4) [not null]
  currency char(3) [not null, default: 'INR']
  status varchar(32) [not null, default: 'INITIATED']
  saga_id uuid [not null]
  failure_reason varchar(500) [null]
  completed_at timestamptz [null]
  metadata jsonb [default: '{}']
  
  indexes {
    (transaction_id, created_at) [pk]
    (idempotency_key, created_at) [unique]
    (source_account_id, created_at)
    (destination_account_id, created_at)
    saga_id
  }
}

Table ledger_entries {
  entry_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  transaction_id uuid [not null]
  account_id uuid [not null, ref: > accounts.account_id]
  entry_type varchar(16) [not null]
  amount numeric(18,4) [not null]
  currency char(3) [not null, default: 'INR']
  balance_after numeric(18,4) [not null]
  
  indexes {
    (entry_id, created_at) [pk]
    (account_id, created_at)
    transaction_id
  }
}

Table transaction_events {
  event_id uuid [pk]
  transaction_id uuid [not null]
  from_state varchar(32) [not null]
  to_state varchar(32) [not null]
  event_name varchar(64) [not null]
  payload jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]
}

Table fraud_rules {
  rule_id varchar(64) [pk]
  rule_name varchar(255) [not null]
  rule_type varchar(32) [not null]
  parameters jsonb [not null]
  action varchar(32) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table merchant_settlements {
  settlement_id uuid [pk]
  batch_id varchar(64) [unique, not null]
  merchant_id uuid [not null, ref: > accounts.account_id]
  transaction_count int [not null]
  gross_amount numeric(18,4) [not null]
  fee_amount numeric(18,4) [not null]
  net_amount numeric(18,4) [not null]
  status varchar(32) [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  settled_at timestamptz [null]
}

Table notification_log {
  notification_id uuid [pk]
  transaction_id uuid [not null]
  channel varchar(32) [not null]
  recipient varchar(255) [not null]
  status varchar(32) [not null, default: 'PENDING']
  attempts int [not null, default: 0]
  last_error varchar(500) [null]
  created_at timestamptz [not null, default: `now()`]
  delivered_at timestamptz [null]
}
